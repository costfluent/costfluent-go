.PHONY: generate lint test fmt tidy

# The Public API document the client is held to. Pass another path to replace the copy first.
OPENAPI_SPEC ?= costfluent/testdata/public.v1.json
CONTRACT := costfluent/testdata/public.v1.json

# The client is hand-written; generate only refreshes the contract its contract test reads and
# records that contract's SHA-256 as ContractSHA256.
generate:
	@if [ ! -f "$(OPENAPI_SPEC)" ]; then echo "OpenAPI spec not found at $(OPENAPI_SPEC)"; exit 1; fi
	@if [ "$(OPENAPI_SPEC)" != "$(CONTRACT)" ]; then cp "$(OPENAPI_SPEC)" "$(CONTRACT)"; fi
	@sum="$$( (sha256sum "$(CONTRACT)" 2>/dev/null || shasum -a 256 "$(CONTRACT)") | cut -d' ' -f1)"; \
	printf '%s\n' \
		'// Code generated by make generate. DO NOT EDIT.' \
		'' \
		'package costfluent' \
		'' \
		'// ContractSHA256 is the SHA-256 of the Public API document this client was built against,' \
		'// costfluent/testdata/public.v1.json.' \
		"const ContractSHA256 = \"$$sum\"" > costfluent/contract.go
	@echo "ContractSHA256 recorded"

lint:
	golangci-lint run ./...

test:
	go test -race -v ./...

test-coverage:
	go test -race -coverprofile=coverage.out ./...
	go tool cover -html=coverage.out -o coverage.html

fmt:
	go fmt ./...

tidy:
	go mod tidy

all: tidy fmt lint test
